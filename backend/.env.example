# Server Settings
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/learnsphere_lms?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_here
JWT_EXPIRES_IN=7d

# AI Evaluation Service (options: mock | gemini | openai | ollama)
AI_PROVIDER=mock
AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Media Storage (Cloudinary - optional in dev, fallback to local/demo URLs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Service (Nodemailer - dev mode outputs to console)
EMAIL_DEV_MODE=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
